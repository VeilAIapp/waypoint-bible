<?xml version="1.0" encoding="utf-8"?>
<!-- Small widget: verse text + reference. Available to all users. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- App wordmark -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WAYPOINT"
        android:textSize="8sp"
        android:textColor="@color/widget_primary"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:paddingBottom="6dp" />

    <!-- Verse text -->
    <TextView
        android:id="@+id/verse_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="“The steadfast love of the Lord never ceases.”"
        android:textSize="11sp"
        android:textColor="@color/widget_text_primary"
        android:textStyle="italic"
        android:gravity="center"
        android:maxLines="5"
        android:ellipsize="end" />

    <!-- Reference -->
    <TextView
        android:id="@+id/verse_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lamentations 3:22-23"
        android:textSize="9sp"
        android:textColor="@color/widget_primary"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="6dp" />

</LinearLayout>
